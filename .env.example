# ---------------------------------------------------------------------------
# bidoo-bot secrets. Copy to .env and fill in. NEVER commit the .env file.
#
#   cp .env.example .env
#
# Everything that is not a secret lives in config.yaml instead.
# ---------------------------------------------------------------------------

# Telegram bot token, from @BotFather. Looks like 1234567890:AA...
TELEGRAM_BOT_TOKEN=

# Comma or space separated list of Telegram user ids allowed to use the bot.
# Anyone else gets "Access denied.". Leave empty and the bot refuses to start.
# To find your own id: send /start to the bot, then read the log line
# "Denied '/start' from Telegram user id <your id>".
TELEGRAM_ALLOWED_USER_IDS=

# ---------------------------------------------------------------------------
# Optional overrides
# ---------------------------------------------------------------------------

# Path to the config file (default: ./config.yaml, else the packaged defaults).
#BIDOO_CONFIG=config.yaml

# Force dry-run on or off without editing config.yaml.
# 1/true/yes/on = analyse only, 0/false/no/off = actually execute.
#BIDOO_DRY_RUN=1

# ---------------------------------------------------------------------------
# NOT stored here
# ---------------------------------------------------------------------------
# * Google OAuth client   -> a JSON file, path set by gmail.credentials_file
# * Gmail refresh token   -> written by `bidoo-bot gmail-auth` to
#                            gmail.token_file (default secrets/gmail_token.json)
# * Bidoo login           -> never stored. If the browser strategy is used you
#                            sign in by hand into a local browser profile.
